# Base de datos
# Local (Postgres propio):
# DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/RFID
# Supabase (Session pooler, recomendado; el password va URL-encoded):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/RFID

# SSL de la base de datos (obligatorio en Supabase / proveedores gestionados)
DB_SSL=false

# Tamaño del cache de prepared statements de asyncpg.
# Dejar vacío en desarrollo local y con poolers en modo session.
# Poner en 0 SOLO si se usa un pooler en modo transaction (Supabase puerto 6543).
# DB_STATEMENT_CACHE_SIZE=0

# JWT
JWT_SECRET_KEY=changeme_secret_key_32chars_min
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Servidor
HOST=0.0.0.0
PORT=8000
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Simulador RFID (lecturas falsas al arrancar). Apagar en producción.
SIMULADOR_ENABLED=true

# Logging
LOG_LEVEL=INFO
